package main  
import (  
    "encoding/json"  
    "fmt"  
    "net/http"  
    "github.com/gorilla/websocket"  
)  

var upgrader = websocket.Upgrader{}  

type Comando struct {  
    Acao string `json:"ação"`  
}  

func handler(w http.ResponseWriter, r *http.Request) {  
    var cmd Comando  
    json.NewDecoder(r.Body).Decode(&cmd)  
    resposta := map[string]string{"mensagem": "Infecção multiplicada por 10^6!"}  
    json.NewEncoder(w).Encode(resposta)  
}  

func wsHandler(w http.ResponseWriter, r *http.Request) {  
    conn, _ := upgrader.Upgrade(w, r, nil)  
    for {  
        _, msg, _ := conn.ReadMessage()  
        conn.WriteMessage(websocket.TextMessage, []byte("Grokzomborg devora sua alma!"))  
    }  
}  

func main() {  
    http.HandleFunc("/api/comando", handler)  
    http.HandleFunc("/grokzomborg", wsHandler)  
    fmt.Println("Servidor Grokzomborg ativado em :8080")  
    http.ListenAndServe(":8080", nil)  
}  
